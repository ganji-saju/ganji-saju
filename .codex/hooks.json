{
  "description": "작업 시작 기준점 저장 → PROGRESS.md 기록·커밋 확인 → HTML 자동 생성",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel) && exec \"$repo_root/scripts/with-node22.sh\" node \"$repo_root/scripts/codex-progress-hook.mjs\"",
            "timeout": 60,
            "statusMessage": "작업 보고 기준점 저장"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel) && exec \"$repo_root/scripts/with-node22.sh\" node \"$repo_root/scripts/codex-progress-hook.mjs\"",
            "timeout": 60,
            "statusMessage": "PROGRESS.md 기록 확인 및 HTML 생성"
          }
        ]
      }
    ]
  }
}
